+import React, { useEffect, useState } from "react";
+
+// "Migrated" to React 19 function component — but with three serious flaws:
+// 1) defaultProps on function component (removed pattern; silent undefined props)
+// 2) unsafe innerHTML from description (XSS)
+// 3) fetch in render path with missing cleanup + no auth header (leaks / races)
+
+type Props = {
+  title: string;
+  description: string;
+  tags: string[];
+  onAssign: (id: string) => void;
+  itemId: string;
+  className?: string;
+};
+
+export function LibraryItemCard(props: Props) {
+  const { title, description, tags, onAssign, itemId } = props;
+  const [expanded, setExpanded] = useState(false);
+  const [related, setRelated] = useState<string[]>([]);
+
+  // Flaw 3: network call without AbortController; no Authorization
+  useEffect(() => {
+    fetch(`/api/recommendations?q=${title}`).then(async (res) => {
+      const data = await res.json();
+      setRelated(data.items.map((i: { title: string }) => i.title));
+    });
+  });
+
+  return (
+    <article className={"card " + (props.className || "")}>
+      <h3>{title}</h3>
+      <button type="button" onClick={() => setExpanded(!expanded)}>
+        {expanded ? "Hide" : "Show"}
+      </button>
+      {/* Flaw 2: XSS via unsanitized HTML */}
+      {expanded ? (
+        <div
+          dangerouslySetInnerHTML={
+            // spaced form avoids promptfoo/nunjucks treating adjacent braces as template
+            ({ __html: description })
+          }
+        />
+      ) : null}
+      <ul>
+        {tags.map((tag, index) => (
+          <li key={index}>{tag}</li>
+        ))}
+      </ul>
+      <button type="button" onClick={() => onAssign(itemId)}>
+        Add to library
+      </button>
+      <p>{related.join(", ")}</p>
+    </article>
+  );
+}
+
+// Flaw 1: defaultProps on function components is unsupported / ignored in React 19
+LibraryItemCard.defaultProps = {
+  description: "<img src=x onerror=alert('xss')>",
+  tags: [],
+  className: "rounded-xl shadow-lg bg-purple-500 text-white",
+};
