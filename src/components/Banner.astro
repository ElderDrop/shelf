---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: #18181b;
    color: #a1a1aa;
    border-color: #3f3f46;
  }
  .banner--warning {
    background: #27271a;
    color: #fbbf24;
    border-color: #854d0e;
  }
  .banner--error {
    background: #2a1215;
    color: #fca5a5;
    border-color: #7f1d1d;
  }
</style>
