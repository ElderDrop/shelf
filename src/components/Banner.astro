---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: oklch(0.92 0.02 75);
    color: oklch(0.35 0.04 55);
    border-color: oklch(0.78 0.03 70);
  }
  .banner--warning {
    background: oklch(0.94 0.04 85);
    color: oklch(0.4 0.08 70);
    border-color: oklch(0.75 0.08 75);
  }
  .banner--error {
    background: oklch(0.93 0.03 25);
    color: oklch(0.4 0.14 25);
    border-color: oklch(0.7 0.1 25);
  }
</style>
