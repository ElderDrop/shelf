---
const { user, profile } = Astro.locals;
const isAdmin = profile?.role === "admin";
const brandHref = user ? "/library" : "/";
---

<nav class="border-border bg-card text-foreground w-full border-b px-4 py-2.5 text-sm">
  <div class="flex items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <a
        href={brandHref}
        class="text-primary hover:text-foreground shrink-0 font-semibold tracking-tight transition-colors"
      >
        Shelf
      </a>
      {
        user ? (
          <span class="text-muted-foreground truncate">{user.email}</span>
        ) : (
          <span class="text-muted-foreground">Not signed in</span>
        )
      }
    </div>
    {
      user ? (
        <div class="flex shrink-0 items-center gap-4">
          <a href="/catalog" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
            Catalog
          </a>
          <a href="/library" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
            Library
          </a>
          <a href="/wishlist" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
            Wishlist
          </a>
          <a href="/dashboard" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
            Dashboard
          </a>
          {isAdmin ? (
            <a href="/admin/catalog" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
              Admin
            </a>
          ) : null}
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
              Sign out
            </button>
          </form>
        </div>
      ) : (
        <div class="flex shrink-0 gap-4">
          <a href="/auth/signin" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-foreground/80 hover:text-primary transition-colors hover:underline">
            Sign up
          </a>
        </div>
      )
    }
  </div>
</nav>
