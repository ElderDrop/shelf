---
interface Props {
  signedIn?: boolean;
}

const { signedIn = false } = Astro.props;
---

<main class="shelf-page">
  <div class="mx-auto max-w-3xl py-12 sm:py-16">
    <h1 class="text-foreground text-4xl font-semibold tracking-tight sm:text-5xl">Shelf</h1>
    <p class="text-muted-foreground mt-3 max-w-xl text-base leading-relaxed sm:text-lg">
      One place for your physical books, manga, and comics — what you own, what you want, and what to share.
    </p>

    <ul class="text-foreground/90 mt-10 list-disc space-y-3 pl-5 text-sm leading-relaxed sm:text-base">
      <li>Browse and search the curated catalog, then add titles to your library or wishlist.</li>
      <li>View your library and wishlist with titles, descriptions, and tags.</li>
      <li>Get simple recommendations based on tags and descriptions in your library.</li>
      <li>Generate a read-only share link so others can see your lists without editing them.</li>
    </ul>

    <div class="mt-10 flex flex-wrap gap-3">
      {
        signedIn ? (
          <>
            <a
              href="/catalog"
              class="bg-primary text-primary-foreground inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-medium hover:opacity-90"
            >
              Browse catalog
            </a>
            <a
              href="/library"
              class="border-border bg-card text-foreground hover:bg-accent inline-flex items-center justify-center rounded-md border px-5 py-2.5 text-sm font-medium"
            >
              Open library
            </a>
          </>
        ) : (
          <>
            <a
              href="/auth/signup"
              class="bg-primary text-primary-foreground inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-medium hover:opacity-90"
            >
              Sign up
            </a>
            <a
              href="/auth/signin"
              class="border-border bg-card text-foreground hover:bg-accent inline-flex items-center justify-center rounded-md border px-5 py-2.5 text-sm font-medium"
            >
              Sign in
            </a>
          </>
        )
      }
    </div>
  </div>
</main>
