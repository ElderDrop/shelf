---
import Layout from "@/layouts/Layout.astro";

Astro.response.status = 403;
---

<Layout title="Shelf — Forbidden">
  <main class="min-h-[calc(100vh-3rem)] bg-zinc-950 p-4 text-zinc-100 sm:p-8">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <p class="text-sm font-medium tracking-wide text-zinc-400 uppercase">403</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight text-zinc-100">Admin only</h1>
      <p class="mt-3 text-sm text-zinc-400">
        This page is limited to administrators. If you need access, ask an operator to promote your account.
      </p>
      <a href="/catalog" class="mt-6 text-sm text-zinc-200 underline hover:text-white"> Go to catalog </a>
    </div>
  </main>
</Layout>
