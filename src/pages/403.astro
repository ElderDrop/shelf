---
import Layout from "@/layouts/Layout.astro";

Astro.response.status = 403;
---

<Layout title="Shelf — Forbidden">
  <main class="shelf-page">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <p class="text-muted-foreground text-sm font-medium tracking-wide uppercase">403</p>
      <h1 class="text-foreground mt-2 text-2xl font-semibold tracking-tight">Admin only</h1>
      <p class="text-muted-foreground mt-3 text-sm">
        This page is limited to administrators. If you need access, ask an operator to promote your account.
      </p>
      <a href="/catalog" class="text-primary hover:text-foreground mt-6 text-sm underline">Go to catalog</a>
    </div>
  </main>
</Layout>
