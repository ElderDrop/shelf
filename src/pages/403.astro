---
import Layout from "@/layouts/Layout.astro";

Astro.response.status = 403;
---

<Layout title="Forbidden">
  <div class="flex min-h-[calc(100vh-3rem)] items-center justify-center bg-zinc-950 p-4">
    <div class="max-w-md text-center">
      <p class="text-sm font-medium tracking-wide text-zinc-400 uppercase">403</p>
      <h1 class="mt-2 text-2xl font-semibold text-zinc-100">Admin only</h1>
      <p class="mt-3 text-sm text-zinc-400">
        This page is limited to administrators. If you need access, ask an operator to promote your account.
      </p>
      <a
        href="/catalog"
        class="mt-6 inline-block text-sm text-violet-300 underline-offset-4 transition-colors hover:text-violet-200 hover:underline"
      >
        Go to catalog
      </a>
    </div>
  </div>
</Layout>
