---
import Layout from "@/layouts/Layout.astro";
import CatalogList from "@/components/admin/CatalogList";
import { createClient } from "@/lib/supabase";
import { listAll } from "@/lib/services/catalog";
import type { CatalogItem } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let configError = false;
let items: CatalogItem[] = [];

if (!supabase) {
  configError = true;
  Astro.response.status = 500;
} else {
  items = await listAll(supabase);
}
---

{
  configError ? (
    <Layout title="Shelf — Configuration error">
      <main class="min-h-[calc(100vh-3rem)] bg-zinc-950 p-4 text-zinc-100 sm:p-8">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Supabase is not configured</h1>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title="Shelf — Admin catalog">
      <main class="min-h-[calc(100vh-3rem)] bg-zinc-950 p-4 text-zinc-100 sm:p-8">
        <div class="mx-auto max-w-5xl">
          <CatalogList client:load initialItems={items} />
        </div>
      </main>
    </Layout>
  )
}
