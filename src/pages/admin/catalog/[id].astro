---
import Layout from "@/layouts/Layout.astro";
import CatalogForm from "@/components/admin/CatalogForm";
import { createClient } from "@/lib/supabase";
import { CatalogServiceError, getById } from "@/lib/services/catalog";
import { catalogItemIdSchema } from "@/lib/schemas/catalog";
import type { CatalogItem } from "@/types";

const idParsed = catalogItemIdSchema.safeParse(Astro.params.id);
let item: CatalogItem | null = null;
let notFound = false;
let configError = false;

if (!idParsed.success) {
  notFound = true;
  Astro.response.status = 404;
} else {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    configError = true;
    Astro.response.status = 500;
  } else {
    try {
      item = await getById(supabase, idParsed.data);
    } catch (error) {
      if (error instanceof CatalogServiceError && error.code === "not_found") {
        notFound = true;
        Astro.response.status = 404;
      } else {
        throw error;
      }
    }
  }
}
---

{
  notFound ? (
    <Layout title="Shelf — Not found">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Catalog item not found</h1>
          <a href="/admin/catalog" class="text-primary hover:text-foreground mt-4 inline-block text-sm underline">
            Back to list
          </a>
        </div>
      </main>
    </Layout>
  ) : configError ? (
    <Layout title="Shelf — Configuration error">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Supabase is not configured</h1>
        </div>
      </main>
    </Layout>
  ) : item ? (
    <Layout title={`Shelf — Edit: ${item.title}`}>
      <main class="shelf-page">
        <CatalogForm client:load mode="edit" item={item} />
      </main>
    </Layout>
  ) : null
}
