---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={`Shelf — ${content.heading}`}>
  <main class="shelf-page flex items-center justify-center">
    <div class="border-border bg-card w-full max-w-sm rounded-lg border p-8 text-center shadow-sm">
      <h1 class="text-foreground mb-3 text-2xl font-semibold tracking-tight">{content.heading}</h1>
      <p class="text-muted-foreground mb-6 text-sm">{content.description}</p>
      <a href="/auth/signin" class="text-primary hover:text-foreground text-sm underline">
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
