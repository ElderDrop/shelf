---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Shelf — Sign in">
  <main class="shelf-page flex items-center justify-center">
    <div class="border-border bg-card w-full max-w-sm rounded-lg border p-8 shadow-sm">
      <h1 class="text-foreground mb-2 text-center text-2xl font-semibold tracking-tight">Sign in</h1>
      <p class="text-muted-foreground mb-6 text-center text-sm">Welcome back to Shelf.</p>
      <SignInForm serverError={error} client:only="react" />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account?{" "}
        <a href="/auth/signup" class="text-primary hover:text-foreground underline">Sign up</a>
      </p>
    </div>
  </main>
</Layout>
