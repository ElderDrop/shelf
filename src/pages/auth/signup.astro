---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Shelf — Sign up">
  <main class="shelf-page flex items-center justify-center">
    <div class="border-border bg-card w-full max-w-sm rounded-lg border p-8 shadow-sm">
      <h1 class="text-foreground mb-2 text-center text-2xl font-semibold tracking-tight">Sign up</h1>
      <p class="text-muted-foreground mb-6 text-center text-sm">Create your Shelf account.</p>
      <SignUpForm serverError={error} client:only="react" />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Already have an account?{" "}
        <a href="/auth/signin" class="text-primary hover:text-foreground underline">Sign in</a>
      </p>
    </div>
  </main>
</Layout>
