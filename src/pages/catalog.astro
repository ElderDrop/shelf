---
import Layout from "@/layouts/Layout.astro";
import CatalogItemActions from "@/components/catalog/CatalogItemActions";
import EmptyState from "@/components/EmptyState.astro";
import MediaItemRow from "@/components/collection/MediaItemRow.astro";
import { createClient } from "@/lib/supabase";
import { listApproved } from "@/lib/services/catalog";
import { listAssignmentStateForCatalog } from "@/lib/services/assignments";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const searchQuery = Astro.url.searchParams.get("q") ?? "";
const hasSearch = searchQuery.trim().length > 0;

let configError = false;
let items = [] as Awaited<ReturnType<typeof listApproved>>;
let assignmentState = new Map<string, { listType: "library" | "wishlist"; assignmentId: string }>();

if (!supabase) {
  configError = true;
  Astro.response.status = 500;
} else {
  items = await listApproved(supabase, searchQuery);
  assignmentState = await listAssignmentStateForCatalog(
    supabase,
    items.map((item) => item.id),
  );
}
---

{
  configError ? (
    <Layout title="Shelf — Configuration error">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Supabase is not configured</h1>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title="Shelf — Catalog">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Catalog</h1>
          <p class="text-muted-foreground mt-1 text-sm">Approved titles you can browse from the shared catalog.</p>

          <form method="GET" action="/catalog" class="mt-6 flex gap-2">
            <input
              type="search"
              name="q"
              value={searchQuery}
              placeholder="Search by title, description, or tag…"
              class="border-input bg-card text-foreground placeholder:text-muted-foreground focus:border-ring flex-1 rounded-md border px-3 py-2 text-sm focus:outline-none"
            />
            <button
              type="submit"
              class="bg-primary text-primary-foreground rounded-md px-4 py-2 text-sm font-medium hover:opacity-90"
            >
              Search
            </button>
          </form>

          {items.length === 0 ? (
            <EmptyState>
              {hasSearch
                ? "No approved items match your search. Try a different query or clear the search box."
                : "No approved items are available yet. Check back after the catalog has been curated."}
            </EmptyState>
          ) : (
            <ul class="mt-8 space-y-6">
              {items.map((item) => {
                const assignment = assignmentState.get(item.id);
                return (
                  <li class="border-border border-b pb-6 last:border-b-0">
                    <MediaItemRow title={item.title} description={item.description} tags={item.tags} />
                    {assignment ? (
                      <CatalogItemActions
                        client:only="react"
                        catalogItemId={item.id}
                        listType={assignment.listType}
                        assignmentId={assignment.assignmentId}
                      />
                    ) : (
                      <CatalogItemActions client:only="react" catalogItemId={item.id} />
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </main>
    </Layout>
  )
}
