---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listApproved } from "@/lib/services/catalog";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const items = supabase ? await listApproved(supabase) : [];
---

<Layout title="Catalog">
  <main class="min-h-[calc(100vh-3rem)] bg-zinc-950 p-4 text-zinc-100 sm:p-8">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-2xl font-semibold tracking-tight">Catalog</h1>
      <p class="mt-1 text-sm text-zinc-400">Approved titles you can browse from the shared catalog.</p>

      {
        items.length === 0 ? (
          <p class="mt-10 text-sm text-zinc-400">
            No approved items are available yet. Check back after the catalog has been curated.
          </p>
        ) : (
          <ul class="mt-8 space-y-6">
            {items.map((item) => (
              <li class="border-b border-zinc-800 pb-6 last:border-b-0">
                <h2 class="text-lg font-medium text-zinc-50">{item.title}</h2>
                {item.description ? <p class="mt-2 text-sm leading-relaxed text-zinc-300">{item.description}</p> : null}
                {item.tags.length > 0 ? (
                  <p class="mt-3 text-xs tracking-wide text-zinc-500 uppercase">{item.tags.join(" · ")}</p>
                ) : null}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</Layout>
