---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Shelf — Dashboard">
  <main class="shelf-page">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
      <p class="text-muted-foreground mt-1 text-sm">
        Signed in as <span class="text-foreground font-medium">{user?.email}</span>
      </p>

      <ul class="mt-8 space-y-3 text-sm">
        <li>
          <a href="/catalog" class="text-primary hover:text-foreground underline">Catalog</a>
          <span class="text-muted-foreground"> — browse and assign titles</span>
        </li>
        <li>
          <a href="/library" class="text-primary hover:text-foreground underline">Library</a>
          <span class="text-muted-foreground"> — what you own, plus recommendations and sharing</span>
        </li>
        <li>
          <a href="/wishlist" class="text-primary hover:text-foreground underline">Wishlist</a>
          <span class="text-muted-foreground"> — titles you want later</span>
        </li>
      </ul>

      <form method="POST" action="/api/auth/signout" class="mt-10">
        <button
          type="submit"
          class="border-border bg-card text-foreground hover:bg-accent rounded-md border px-4 py-2 text-sm"
        >
          Sign out
        </button>
      </form>
    </div>
  </main>
</Layout>
