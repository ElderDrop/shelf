---
import Layout from "@/layouts/Layout.astro";
import CatalogItemActions from "@/components/catalog/CatalogItemActions";
import CollectionItemActions from "@/components/collection/CollectionItemActions";
import ShareLinkControls from "@/components/share/ShareLinkControls";
import { createClient } from "@/lib/supabase";
import { listForUser } from "@/lib/services/assignments";
import { recommendForUser } from "@/lib/services/recommendations";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let configError = false;
let assignments = [] as Awaited<ReturnType<typeof listForUser>>;
let recommendations = null as Awaited<ReturnType<typeof recommendForUser>> | null;
let recommendationsUnavailable = false;

if (!supabase) {
  configError = true;
  Astro.response.status = 500;
} else {
  const allAssignments = await listForUser(supabase);
  assignments = allAssignments.filter((row) => row.list_type === "library");
  try {
    recommendations = await recommendForUser(supabase, { assignments: allAssignments });
  } catch (error) {
    console.error("recommendations failed:", error instanceof Error ? error.message : error);
    recommendationsUnavailable = true;
  }
}
---

{
  configError ? (
    <Layout title="Configuration error">
      <main class="min-h-[calc(100vh-3rem)] bg-zinc-950 p-8 text-zinc-100">
        <h1 class="text-xl font-semibold">Supabase is not configured</h1>
      </main>
    </Layout>
  ) : (
    <Layout title="Library">
      <main class="min-h-[calc(100vh-3rem)] bg-zinc-950 p-4 text-zinc-100 sm:p-8">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Library</h1>
          <p class="mt-1 text-sm text-zinc-400">Items you own or have finished.</p>

          <ShareLinkControls client:only="react" />

          {recommendationsUnavailable ? (
            <section class="mt-8 rounded-md border border-zinc-800 bg-zinc-900/40 p-4">
              <h2 class="text-sm font-medium text-zinc-200">Recommended for you</h2>
              <p class="mt-2 text-sm text-zinc-400">Recommendations are temporarily unavailable.</p>
            </section>
          ) : null}

          {recommendations && !recommendations.eligible ? (
            <section class="mt-8 rounded-md border border-zinc-800 bg-zinc-900/40 p-4">
              <h2 class="text-sm font-medium text-zinc-200">Recommended for you</h2>
              <p class="mt-2 text-sm text-zinc-400">
                Recommendations unlock after you have at least 3 library items with tags. You have{" "}
                {recommendations.taggedLibraryCount} tagged{" "}
                {recommendations.taggedLibraryCount === 1 ? "item" : "items"} in your library.
              </p>
            </section>
          ) : null}

          {recommendations?.eligible ? (
            <section class="mt-8">
              <h2 class="text-lg font-medium text-zinc-50">Recommended for you</h2>
              {recommendations.items.length === 0 ? (
                <p class="mt-2 text-sm text-zinc-400">No recommendations match your library yet.</p>
              ) : (
                <ul class="mt-4 space-y-6">
                  {recommendations.items.map(({ candidate }) => (
                    <li class="border-b border-zinc-800 pb-6 last:border-b-0">
                      <h3 class="text-base font-medium text-zinc-50">{candidate.title}</h3>
                      {candidate.description ? (
                        <p class="mt-2 text-sm leading-relaxed text-zinc-300">{candidate.description}</p>
                      ) : null}
                      {candidate.tags.length > 0 ? (
                        <p class="mt-3 text-xs tracking-wide text-zinc-500 uppercase">{candidate.tags.join(" · ")}</p>
                      ) : null}
                      <CatalogItemActions client:only="react" catalogItemId={candidate.id} />
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ) : null}

          {assignments.length === 0 ? (
            <p class="mt-10 text-sm text-zinc-400">
              Your library is empty. Browse the{" "}
              <a href="/catalog" class="text-zinc-200 underline hover:text-white">
                catalog
              </a>{" "}
              to add items.
            </p>
          ) : (
            <ul class="mt-8 space-y-6">
              {assignments.map((assignment) => {
                const item = assignment.catalog_item;
                const unavailable = item == null;
                return (
                  <li class="border-b border-zinc-800 pb-6 last:border-b-0">
                    {unavailable ? (
                      <>
                        <p class="text-sm text-zinc-400">This item is no longer available in the catalog.</p>
                        <CollectionItemActions
                          client:only="react"
                          assignmentId={assignment.id}
                          catalogItemId={assignment.catalog_item_id}
                          listType="library"
                          unavailable
                        />
                      </>
                    ) : (
                      <>
                        <h2 class="text-lg font-medium text-zinc-50">{item.title}</h2>
                        {item.description ? (
                          <p class="mt-2 text-sm leading-relaxed text-zinc-300">{item.description}</p>
                        ) : null}
                        {item.tags.length > 0 ? (
                          <p class="mt-3 text-xs tracking-wide text-zinc-500 uppercase">{item.tags.join(" · ")}</p>
                        ) : null}
                        <CollectionItemActions
                          client:only="react"
                          assignmentId={assignment.id}
                          catalogItemId={assignment.catalog_item_id}
                          listType="library"
                        />
                      </>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </main>
    </Layout>
  )
}
