---
import Layout from "@/layouts/Layout.astro";
import EmptyState from "@/components/EmptyState.astro";
import MediaItemRow from "@/components/collection/MediaItemRow.astro";
import { shareTokenSchema } from "@/lib/schemas/share";
import { resolveShareByToken } from "@/lib/services/share";
import type { ShareAssignmentItem } from "@/lib/services/share";

export const prerender = false;

const rawToken = Astro.params.token ?? "";
const parsed = shareTokenSchema.safeParse(rawToken);

let failed = !parsed.success;
let library: ShareAssignmentItem[] = [];
let wishlist: ShareAssignmentItem[] = [];

if (parsed.success) {
  try {
    const resolved = await resolveShareByToken(parsed.data);
    library = resolved.library;
    wishlist = resolved.wishlist;
  } catch {
    failed = true;
  }
}

if (failed) {
  Astro.response.status = 404;
}
---

{
  failed ? (
    <Layout title="Shelf — Share link unavailable">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Share link unavailable</h1>
          <p class="text-muted-foreground mt-1 text-sm">This share link is invalid or has been revoked.</p>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title="Shelf — Shared collection">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Shared collection</h1>
          <p class="text-muted-foreground mt-1 text-sm">Read-only view of library and wishlist.</p>

          <section class="mt-10">
            <h2 class="text-foreground text-lg font-medium">Library</h2>
            {library.length === 0 ? (
              <EmptyState class="mt-2">No library items.</EmptyState>
            ) : (
              <ul class="mt-4 space-y-6">
                {library.map((row) => (
                  <li class="border-border border-b pb-6 last:border-b-0">
                    <MediaItemRow
                      title={row.catalog_item.title}
                      description={row.catalog_item.description}
                      tags={row.catalog_item.tags}
                      titleAs="h3"
                    />
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="mt-10">
            <h2 class="text-foreground text-lg font-medium">Wishlist</h2>
            {wishlist.length === 0 ? (
              <EmptyState class="mt-2">No wishlist items.</EmptyState>
            ) : (
              <ul class="mt-4 space-y-6">
                {wishlist.map((row) => (
                  <li class="border-border border-b pb-6 last:border-b-0">
                    <MediaItemRow
                      title={row.catalog_item.title}
                      description={row.catalog_item.description}
                      tags={row.catalog_item.tags}
                      titleAs="h3"
                    />
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      </main>
    </Layout>
  )
}
