---
import Layout from "@/layouts/Layout.astro";
import CollectionItemActions from "@/components/collection/CollectionItemActions";
import EmptyState from "@/components/EmptyState.astro";
import MediaItemRow from "@/components/collection/MediaItemRow.astro";
import { createClient } from "@/lib/supabase";
import { listForUser } from "@/lib/services/assignments";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let configError = false;
let assignments = [] as Awaited<ReturnType<typeof listForUser>>;

if (!supabase) {
  configError = true;
  Astro.response.status = 500;
} else {
  assignments = await listForUser(supabase, "wishlist");
}
---

{
  configError ? (
    <Layout title="Shelf — Configuration error">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Supabase is not configured</h1>
        </div>
      </main>
    </Layout>
  ) : (
    <Layout title="Shelf — Wishlist">
      <main class="shelf-page">
        <div class="mx-auto max-w-3xl">
          <h1 class="text-2xl font-semibold tracking-tight">Wishlist</h1>
          <p class="text-muted-foreground mt-1 text-sm">Items you want to pick up later.</p>

          {assignments.length === 0 ? (
            <EmptyState>
              Your wishlist is empty. Browse the{" "}
              <a href="/catalog" class="text-primary hover:text-foreground underline">
                catalog
              </a>{" "}
              to add items.
            </EmptyState>
          ) : (
            <ul class="mt-8 space-y-6">
              {assignments.map((assignment) => {
                const item = assignment.catalog_item;
                const unavailable = item == null;
                return (
                  <li class="border-border border-b pb-6 last:border-b-0">
                    {unavailable ? (
                      <MediaItemRow unavailable />
                    ) : (
                      <MediaItemRow title={item.title} description={item.description} tags={item.tags} />
                    )}
                    <CollectionItemActions
                      client:only="react"
                      assignmentId={assignment.id}
                      catalogItemId={assignment.catalog_item_id}
                      listType="wishlist"
                      unavailable={unavailable}
                    />
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </main>
    </Layout>
  )
}
